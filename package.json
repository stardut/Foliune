{
  "name": "foliune",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.19.0",
  "scripts": {
    "dev": "pnpm --filter @foliune/desktop dev",
    "desktop": "pnpm --filter @foliune/desktop tauri dev",
    "build": "pnpm --filter @foliune/desktop build",
    "typecheck": "pnpm --filter @foliune/desktop typecheck",
    "desktop:build": "pnpm --filter @foliune/desktop tauri build --no-bundle",
    "test:release": "node --test scripts/prepare-release.test.mjs scripts/updater-release.test.mjs scripts/publish-release.test.mjs",
    "test:pages": "node --test scripts/check-pages-deployment.test.mjs scripts/latest-release.test.mjs scripts/prepare-site-release.test.mjs"
  }
}
